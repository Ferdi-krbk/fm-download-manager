<Window x:Class="McDm.App.AddUrlsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADD DOWNLOAD URLS" Width="560" Height="400" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg0Brush}"
        FontFamily="{DynamicResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Content Area -->
                <RowDefinition Height="56" />  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="Cancel_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtWinHeader" Text="Bağlantı(lar) Ekle" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="14,0" />
                </DockPanel>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="16,14,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PromptText" Grid.Row="0"
                           Text="Enter one download URL per line:"
                           FontFamily="{DynamicResource UiFont}" FontSize="12"
                           Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,8" />

                <!-- Multi-line URL TextBox (Consolas, Bg2, 1px Line) -->
                <Border Grid.Row="1" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <TextBox x:Name="UrlsBox"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12"
                             Foreground="{DynamicResource TextBrush}"
                             Padding="10"
                             TextChanged="UrlsBox_TextChanged" />
                </Border>

                <!-- Valid links live counter -->
                <TextBlock x:Name="ValidLinksCountText" Grid.Row="2"
                           Text="0 VALID LINKS"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                           Foreground="{DynamicResource TextDimBrush}" Margin="0,8,0,0" />
            </Grid>

            <!-- Action Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Style="{DynamicResource SecondaryButton}" Content="CANCEL" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="OkButton" Style="{DynamicResource PrimaryButton}" Content="DOWNLOAD" Width="110" Click="Ok_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
