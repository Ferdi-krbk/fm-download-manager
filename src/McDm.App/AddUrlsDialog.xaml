<Window x:Class="McDm.App.AddUrlsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add URL(s)" Width="520" Height="360" MinWidth="400" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" />

        <TextBox x:Name="UrlsBox" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, monospace" FontSize="13" Padding="6" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" IsDefault="True" Width="120" Height="32" Margin="0,0,8,0" Click="Ok_Click" />
            <Button x:Name="CancelButton" IsCancel="True" Width="90" Height="32" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
