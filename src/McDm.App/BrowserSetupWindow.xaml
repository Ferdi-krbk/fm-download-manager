<Window x:Class="McDm.App.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TARAYICI EKLENTİSİ KURULUMU" Width="680" Height="580" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg0Brush}"
        FontFamily="{DynamicResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Main Content -->
                <RowDefinition Height="56" />  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="Close_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtWinHeader" Text="Tarayıcı Eklentisi Kurulum Merkezi" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="14,0" />
                </DockPanel>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,14,0">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitle" Text="Tek Tıkla Tarayıcıya Kurulum" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock x:Name="TxtSubtitle" Text="Tarayıcınızı seçin; eklenti otomatik olarak kurulacak ve eşleştirilecektir." Foreground="{DynamicResource TextDimBrush}" FontSize="12.5" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Big 1-Click Install Section -->
                    <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="LblAutoSection" Text="OTOMATİK KURULUM SEÇENEKLERİ" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />
                            
                            <!-- Chrome Button -->
                            <Button x:Name="BtnAutoChrome" Style="{DynamicResource PrimaryButton}" Height="46" Margin="0,0,0,8" Click="OpenChrome_Click">
                                <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
                                    <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtChromeTitle" Text="Google Chrome Eklenti Sayfasını Aç" FontWeight="Bold" FontSize="13" />
                                        <TextBlock x:Name="TxtChromeSub" Text="Yolu panoya kopyalar, klasörü açar ve Chrome'u başlatır" FontSize="10.5" Foreground="{DynamicResource OnAccentBrush}" Opacity="0.85" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <!-- Edge Button -->
                            <Button x:Name="BtnAutoEdge" Style="{DynamicResource SecondaryButton}" Height="46" Margin="0,0,0,8" Click="OpenEdge_Click">
                                <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
                                    <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtEdgeTitle" Text="Microsoft Edge Eklenti Sayfasını Aç" FontWeight="Bold" FontSize="13" />
                                        <TextBlock x:Name="TxtEdgeSub" Text="Yolu panoya kopyalar, klasörü açar ve Edge'i başlatır" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <!-- Brave Button -->
                            <Button x:Name="BtnAutoBrave" Style="{DynamicResource SecondaryButton}" Height="46" Click="OpenBrave_Click">
                                <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
                                    <TextBlock Text="🦁" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBraveTitle" Text="Brave Eklenti Sayfasını Aç" FontWeight="Bold" FontSize="13" />
                                        <TextBlock x:Name="TxtBraveSub" Text="Yolu panoya kopyalar, klasörü açar ve Brave'i başlatır" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <!-- Quick Tip -->
                            <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblQuickTipTitle" Text="💡 2 Adımda Kolay Kurulum:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,3" />
                                    <TextBlock x:Name="TxtQuickTipSteps" Text="1. Butona tıklayın: Eklenti klasörü açılır ve yolu panonuza kopyalanır.&#x0a;2. Tarayıcıda sağ üstten 'Geliştirici modu'nu açın ve 'Paketlenmemiş öge yükle' diyerek bu klasörü seçin." FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtQuickTipAuto" Text="✓ Eşleştirme kodu gerekmez — Eklenti yüklendiği saniye otomatik bağlanır!" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Live Connection Indicator Block -->
                    <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                        <DockPanel LastChildFill="True">
                            <Ellipse x:Name="DotStatus" Width="12" Height="12" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblConnectionStatus" Text="EKLENTİ BAĞLANTI DURUMU" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                                <TextBlock x:Name="TxtStatus" Text="Tarayıcı bekleniyor..." FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Advanced / Manual Installation Expander -->
                    <Expander x:Name="ExpManual" Header="Gelişmiş / Manuel Kurulum Bilgileri" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Background="Transparent" BorderBrush="{DynamicResource LineBrush}">
                        <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LblExtPath" Text="Eklenti Klasörü Konumu:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtExtPath" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="11" />
                                    <Button x:Name="BtnOpenFolder" Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="Klasörü Aç" Margin="8,0,0,0" Click="OpenFolder_Click" />
                                </Grid>

                                <TextBlock x:Name="LblToken" Text="Eşleştirme Güvenlik Kodu:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtToken" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                    <Button x:Name="BtnCopyCode" Grid.Column="1" Style="{DynamicResource PrimaryButton}" Content="Kodu Kopyala" Margin="8,0,0,0" Click="CopyToken_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Button x:Name="BtnClose" Style="{DynamicResource SecondaryButton}" Content="TAMAMLA" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
            </Border>
        </Grid>
    </Border>
</Window>
