<Window x:Class="McDm.App.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Extension Setup" Width="600" Height="520" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock x:Name="TxtSubtitle" Foreground="#666" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Step 1 -->
                <TextBlock x:Name="LblStep1" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtExtPath" Grid.Column="0" IsReadOnly="True" Height="28" Padding="4" VerticalContentAlignment="Center" />
                    <Button x:Name="BtnOpenFolder" Grid.Column="1" Margin="8,0,0,0" Padding="12,0" Height="28" Click="OpenFolder_Click" />
                </Grid>

                <!-- Step 2 -->
                <TextBlock x:Name="LblStep2" FontWeight="SemiBold" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,16">
                    <Button x:Name="BtnChrome" Margin="0,0,8,8" Padding="12,6" Click="OpenChrome_Click" />
                    <Button x:Name="BtnEdge" Margin="0,0,8,8" Padding="12,6" Click="OpenEdge_Click" />
                    <Button x:Name="BtnBrave" Margin="0,0,8,8" Padding="12,6" Click="OpenBrave_Click" />
                </WrapPanel>

                <!-- Step 3 -->
                <TextBlock x:Name="LblStep3" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#333" />

                <!-- Step 4 -->
                <TextBlock x:Name="LblStep4" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtToken" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas" Height="28" Padding="4" VerticalContentAlignment="Center" />
                    <Button x:Name="BtnCopyCode" Grid.Column="1" Margin="8,0,0,0" Padding="12,0" Height="28" Click="CopyToken_Click" />
                </Grid>

                <!-- Status check -->
                <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="LblConnectionStatus" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtStatus" Text="Checking..." Foreground="#2563EB" FontWeight="Medium" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnClose" IsDefault="True" Width="100" Height="32" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
