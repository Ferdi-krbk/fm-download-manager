<Window x:Class="McDm.App.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Extension Setup" Width="620" Height="540" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <Style x:Key="SubBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubPrimaryBtn" TargetType="Button" BasedOn="{StaticResource SubBtn}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0369A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4" />
            <TextBlock x:Name="TxtSubtitle" Foreground="#94A3B8" TextWrapping="Wrap" FontSize="13" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Step 1 -->
                <TextBlock x:Name="LblStep1" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Height="34">
                        <TextBox x:Name="TxtExtPath" IsReadOnly="True" Background="Transparent" Foreground="#F8FAFC"
                                 BorderThickness="0" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" />
                    </Border>
                    <Button x:Name="BtnOpenFolder" Grid.Column="1" Style="{StaticResource SubBtn}" Margin="8,0,0,0" Height="34" Click="OpenFolder_Click" />
                </Grid>

                <!-- Step 2 -->
                <TextBlock x:Name="LblStep2" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,16">
                    <Button x:Name="BtnChrome" Style="{StaticResource SubBtn}" Margin="0,0,8,8" Click="OpenChrome_Click" />
                    <Button x:Name="BtnEdge" Style="{StaticResource SubBtn}" Margin="0,0,8,8" Click="OpenEdge_Click" />
                    <Button x:Name="BtnBrave" Style="{StaticResource SubBtn}" Margin="0,0,8,8" Click="OpenBrave_Click" />
                </WrapPanel>

                <!-- Step 3 -->
                <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <TextBlock x:Name="LblStep3" TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="13" />
                </Border>

                <!-- Step 4 -->
                <TextBlock x:Name="LblStep4" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Height="34">
                        <TextBox x:Name="TxtToken" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8"
                                 BorderThickness="0" FontFamily="Consolas" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" />
                    </Border>
                    <Button x:Name="BtnCopyCode" Grid.Column="1" Style="{StaticResource SubPrimaryBtn}" Margin="8,0,0,0" Height="34" Click="CopyToken_Click" />
                </Grid>

                <!-- Status check -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="LblConnectionStatus" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtStatus" Text="Checking..." Foreground="#38BDF8" FontWeight="Bold" FontSize="14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnClose" Style="{StaticResource SubBtn}" IsDefault="True" Width="100" Height="34" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
