<Window x:Class="McDm.App.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BROWSER EXTENSION SETUP" Width="640" Height="580" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg0Brush}"
        FontFamily="{DynamicResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Scrollable Steps -->
                <RowDefinition Height="56" />  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="Close_Click" />
                    </StackPanel>
                    <TextBlock Text="BROWSER EXTENSION SETUP" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="14,0" />
                </DockPanel>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="BROWSER INTEGRATION" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtSubtitle" Text="Pair the extension once to capture downloads seamlessly." Foreground="{DynamicResource TextDimBrush}" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap" />

                    <!-- Step 1 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{DynamicResource Bg2Brush}">
                            <TextBlock Text="1" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="LblStep1" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtExtPath" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="11" />
                                <Button x:Name="BtnOpenFolder" Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="OPEN FOLDER" Margin="8,0,0,0" Click="OpenFolder_Click" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Step 2 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{DynamicResource Bg2Brush}">
                            <TextBlock Text="2" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="LblStep2" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                            <WrapPanel>
                                <Button x:Name="BtnChrome" Style="{DynamicResource SecondaryButton}" Content="CHROME" Margin="0,0,8,8" Click="OpenChrome_Click" />
                                <Button x:Name="BtnEdge" Style="{DynamicResource SecondaryButton}" Content="EDGE" Margin="0,0,8,8" Click="OpenEdge_Click" />
                                <Button x:Name="BtnBrave" Style="{DynamicResource SecondaryButton}" Content="BRAVE" Margin="0,0,8,8" Click="OpenBrave_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Step 3 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{DynamicResource Bg2Brush}">
                            <TextBlock Text="3" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12">
                                <TextBlock x:Name="LblStep3" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Step 4 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{DynamicResource Bg2Brush}">
                            <TextBlock Text="4" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="LblStep4" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtToken" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                <Button x:Name="BtnCopyCode" Grid.Column="1" Style="{DynamicResource PrimaryButton}" Content="COPY CODE" Margin="8,0,0,0" Click="CopyToken_Click" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Live Connection Indicator Block -->
                    <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock x:Name="LblConnectionStatus" Text="BRIDGE CONNECTION STATUS" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                                <TextBlock x:Name="TxtStatus" Text="WAITING FOR EXTENSION..." FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Button x:Name="BtnClose" Style="{DynamicResource SecondaryButton}" Content="CLOSE" Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
            </Border>
        </Grid>
    </Border>
</Window>
