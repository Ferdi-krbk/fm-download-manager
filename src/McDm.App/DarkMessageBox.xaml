<Window x:Class="McDm.App.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="520"
        MinHeight="180">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg0Brush}" CornerRadius="11,11,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource WindowCloseButtonStyle}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                              Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                        <TextBlock x:Name="TxtTitle" Text="FM Download Manager" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Viewbox x:Name="IconBox" Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,18,0">
                    <Path x:Name="IconPath" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" />
                </Viewbox>

                <TextBlock x:Name="TxtMessage" Grid.Column="1" TextWrapping="Wrap"
                           FontFamily="{DynamicResource UiFont}" FontSize="13" LineHeight="20"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            </Grid>

            <!-- Buttons Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Bg0Brush}" CornerRadius="0,0,11,11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnYes" Style="{DynamicResource PrimaryButton}" Content="Evet" MinWidth="85" Margin="8,0,0,0" Click="Yes_Click" />
                    <Button x:Name="BtnNo" Style="{DynamicResource SecondaryButton}" Content="Hayır" MinWidth="85" Margin="8,0,0,0" Click="No_Click" />
                    <Button x:Name="BtnOk" Style="{DynamicResource PrimaryButton}" Content="Tamam" MinWidth="85" Margin="8,0,0,0" Click="Ok_Click" />
                    <Button x:Name="BtnCancel" Style="{DynamicResource SecondaryButton}" Content="İptal" MinWidth="85" Margin="8,0,0,0" Click="Cancel_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
