<Window x:Class="McDm.App.DownloadDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Details" Width="550" Height="420" MinWidth="450" MinHeight="350"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- File -->
        <TextBlock x:Name="LblFile" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,8" />
        <TextBlock x:Name="TxtFileName" Grid.Row="0" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

        <!-- URL -->
        <TextBlock x:Name="LblUrl" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,8" />
        <TextBox x:Name="TxtUrl" Grid.Row="1" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

        <!-- Status -->
        <TextBlock x:Name="LblStatus" Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,8" />
        <TextBlock x:Name="TxtStatus" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <!-- Downloaded -->
        <TextBlock x:Name="LblDownloaded" Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,8" />
        <TextBlock x:Name="TxtDownloaded" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

        <!-- Speed -->
        <TextBlock x:Name="LblSpeed" Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,8" />
        <TextBlock x:Name="TxtSpeed" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

        <!-- Overall Progress -->
        <ProgressBar x:Name="PrgOverall" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Height="18" Minimum="0" Maximum="1" Margin="0,4,0,12" />

        <!-- Segments / Connections -->
        <GroupBox x:Name="GrpSegments" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Header="Segments / Connections" Margin="0,0,0,12">
            <DataGrid x:Name="GridSegments" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                    <DataGridTextColumn Header="Range" Binding="{Binding RangeText}" Width="*" />
                    <DataGridTextColumn Header="Downloaded" Binding="{Binding DoneText}" Width="110" />
                    <DataGridTextColumn Header="Progress" Binding="{Binding PercentText}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnClose" IsDefault="True" IsCancel="True" Content="Close" Width="90" Height="28" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
