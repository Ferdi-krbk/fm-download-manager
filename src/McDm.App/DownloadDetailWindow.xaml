<Window x:Class="McDm.App.DownloadDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOWNLOAD PROPERTIES" Width="600" Height="480" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg0Brush}"
        FontFamily="{DynamicResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Key stats & Segment visualizer -->
                <RowDefinition Height="56" />  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="Close_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtWinHeader" Text="İndirme Ayrıntıları" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="14,0" />
                </DockPanel>
            </Border>

            <!-- Main Body -->
            <Grid Grid.Row="1" Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- File name & URL -->
                    <RowDefinition Height="Auto" />  <!-- Key stats row -->
                    <RowDefinition Height="Auto" />  <!-- Overall Progress -->
                    <RowDefinition Height="*" />     <!-- Segments DataGrid -->
                </Grid.RowDefinitions>

                <!-- Header: File Name + URL -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtFileName" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtUrl" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" MaxHeight="40" VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="LblFile" Visibility="Collapsed" />
                    <TextBlock x:Name="LblUrl" Visibility="Collapsed" />
                </StackPanel>

                <!-- Key stats row (SIZE, DOWNLOADED, SPEED, STATUS) -->
                <Border Grid.Row="1" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock x:Name="LblDownloaded" Text="DOWNLOADED" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock x:Name="TxtDownloaded" Text="0 B" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="LblSpeed" Text="SPEED" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock x:Name="TxtSpeed" Text="0 B/s" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="LblStatus" Text="STATUS" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock x:Name="TxtStatus" Text="Ready" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CONNECTIONS" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Text="8 ACTIVE" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Overall Progress -->
                <ProgressBar x:Name="PrgOverall" Grid.Row="2" Height="6" Minimum="0" Maximum="1" Margin="0,0,0,14" />

                <!-- Segments DataGrid -->
                <GroupBox x:Name="GrpSegments" Grid.Row="3" Header="SEGMENT CONNECTIONS"
                          FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg1Brush}" Padding="6">
                    <DataGrid x:Name="GridSegments" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Background="{DynamicResource Bg0Brush}" RowBackground="{DynamicResource Bg0Brush}" AlternatingRowBackground="{DynamicResource AltRowBrush}"
                              Foreground="{DynamicResource TextBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                            <DataGridTextColumn Header="RANGE" Binding="{Binding RangeText}" Width="*" />
                            <DataGridTextColumn Header="DOWNLOADED" Binding="{Binding DoneText}" Width="110" />
                            <DataGridTextColumn Header="PROGRESS" Binding="{Binding PercentText}" Width="85" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Button x:Name="BtnClose" Style="{DynamicResource SecondaryButton}" Content="CLOSE" Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
            </Border>
        </Grid>
    </Border>
</Window>
