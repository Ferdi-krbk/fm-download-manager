<Window x:Class="McDm.App.DownloadDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Details" Width="580" Height="440" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0284C7" Offset="0" />
                                        <GradientStop Color="#38BDF8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- File -->
        <TextBlock x:Name="LblFile" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,8,8" />
        <TextBlock x:Name="TxtFileName" Grid.Row="0" Grid.Column="1" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8" />

        <!-- URL -->
        <TextBlock x:Name="LblUrl" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,8,8" />
        <TextBox x:Name="TxtUrl" Grid.Row="1" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#64748B"
                 TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

        <!-- Status -->
        <TextBlock x:Name="LblStatus" Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,8,8" />
        <TextBlock x:Name="TxtStatus" Grid.Row="2" Grid.Column="1" FontWeight="Bold" Foreground="#4ADE80" Margin="0,0,0,8" />

        <!-- Downloaded -->
        <TextBlock x:Name="LblDownloaded" Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,8,8" />
        <TextBlock x:Name="TxtDownloaded" Grid.Row="3" Grid.Column="1" Foreground="#CBD5E1" Margin="0,0,0,8" />

        <!-- Speed -->
        <TextBlock x:Name="LblSpeed" Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,8,8" />
        <TextBlock x:Name="TxtSpeed" Grid.Row="4" Grid.Column="1" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,8" />

        <!-- Overall Progress -->
        <ProgressBar x:Name="PrgOverall" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Height="10" Minimum="0" Maximum="1" Margin="0,6,0,14" />

        <!-- Segments / Connections -->
        <GroupBox x:Name="GrpSegments" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Header="Segments / Connections"
                  Foreground="#94A3B8" BorderBrush="#334155" Margin="0,0,0,12">
            <DataGrid x:Name="GridSegments" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#162035"
                      Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      BorderThickness="0" Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                    <DataGridTextColumn Header="Range" Binding="{Binding RangeText}" Width="*" />
                    <DataGridTextColumn Header="Downloaded" Binding="{Binding DoneText}" Width="120" />
                    <DataGridTextColumn Header="Progress" Binding="{Binding PercentText}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnClose" Style="{StaticResource DetailBtn}" IsDefault="True" IsCancel="True" Content="Close" Width="100" Height="34" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
