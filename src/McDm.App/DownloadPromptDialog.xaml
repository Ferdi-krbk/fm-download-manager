<Window x:Class="McDm.App.DownloadPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İNDİRME ONAYI - FM DOWNLOAD MANAGER"
        Width="580" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="{DynamicResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Form Fields -->
                <RowDefinition Height="60" />  <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg0Brush}" CornerRadius="11,11,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource WindowCloseButtonStyle}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                              Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                        <TextBlock Text="FM Download Manager — İndirme Onayı" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" Margin="22,14,22,6">
                <!-- Header Question -->
                <TextBlock Text="Bu dosya FM Download Manager ile indirilsin mi?" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

                <!-- File Name Field -->
                <TextBlock Text="Dosya Adı:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtFileName" Height="32" FontSize="12.5" Padding="8,4" FontFamily="{DynamicResource UiFont}" Margin="0,0,0,10" />

                <!-- Save Directory Field -->
                <TextBlock Text="Kaydedilecek Klasör:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFolder" Height="32" FontSize="12" Padding="8,4" FontFamily="{DynamicResource UiFont}" />
                    <Button x:Name="BtnBrowse" Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="Gözat..." Height="32" Padding="14,0" Margin="8,0,0,0" Click="Browse_Click" />
                </Grid>

                <!-- URL Preview -->
                <TextBlock Text="Web Bağlantısı (URL):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,2" />
                <TextBlock x:Name="TxtUrl" FontSize="11" Foreground="{DynamicResource TextMuteBrush}" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource MonoFont}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>

            <!-- Buttons Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Bg0Brush}" CornerRadius="0,0,11,11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Style="{DynamicResource SecondaryButton}" Content="İptal" MinWidth="95" Height="34" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="BtnStart" Style="{DynamicResource PrimaryButton}" Content="Şimdi İndir" MinWidth="130" Height="34" FontWeight="Bold" IsDefault="True" Click="Start_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
