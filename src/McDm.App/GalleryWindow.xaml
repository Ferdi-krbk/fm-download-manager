<Window x:Class="McDm.App.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McDm.App"
        Title="STYLE GALLERY - FM DOWNLOAD MANAGER"
        Width="960" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0Brush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{DynamicResource WindowMinButtonStyle}" Click="Minimize_Click" />
                    <Button Style="{DynamicResource WindowMaxButtonStyle}" Click="Maximize_Click" />
                    <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="STYLE GALLERY" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" / HARD BLACK &amp; ORANGE DESIGN SYSTEM" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Gallery Content -->
        <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Buttons Section -->
                <TextBlock Text="BUTTONS" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" />
                <WrapPanel Margin="0,0,0,24">
                    <Button Style="{DynamicResource PrimaryButton}" Content="PRIMARY BUTTON" Margin="0,0,12,8" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="SECONDARY BUTTON" Margin="0,0,12,8" />
                    <Button Style="{DynamicResource GhostButton}" Content="GHOST BUTTON" Margin="0,0,12,8" />
                    <Button Style="{DynamicResource DangerButton}" Content="DANGER BUTTON" Margin="0,0,12,8" />
                    <Button Style="{DynamicResource IconButton}" Content="&#xE896;" Margin="0,0,12,8" ToolTip="Download icon button" />
                    <Button Style="{DynamicResource PrimaryButton}" Content="DISABLED PRIMARY" IsEnabled="False" Margin="0,0,12,8" />
                    <Button Style="{DynamicResource SecondaryButton}" Content="DISABLED SECONDARY" IsEnabled="False" Margin="0,0,12,8" />
                </WrapPanel>

                <Separator Margin="0,0,0,24" />

                <!-- Text Inputs & ComboBox -->
                <TextBlock Text="INPUTS &amp; CONTROLS" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBox Text="Sample input text with focus support" Margin="0,0,0,12" />
                        <TextBox local:WatermarkService.Watermark="Empty input with watermark..." Text="" Margin="0,0,0,12" />
                        <TextBox Text="Disabled input field" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <ComboBox SelectedIndex="0" Margin="0,0,0,12">
                            <ComboBoxItem Content="OPTION 1 - DEFAULT VALUE" />
                            <ComboBoxItem Content="OPTION 2 - SECONDARY VALUE" />
                            <ComboBoxItem Content="OPTION 3 - ADVANCED SETTING" />
                        </ComboBox>
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox Content="Enabled Checkbox" IsChecked="True" Margin="0,0,16,8" />
                            <CheckBox Content="Unchecked Box" IsChecked="False" Margin="0,0,16,8" />
                            <RadioButton Content="Radio A" IsChecked="True" Margin="0,0,16,8" />
                            <RadioButton Content="Radio B" IsChecked="False" Margin="0,0,16,8" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,24" />

                <!-- Progress & Stats -->
                <TextBlock Text="PROGRESS &amp; METRICS" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12" />
                <StackPanel Margin="0,0,0,24">
                    <ProgressBar Value="65" Maximum="100" Margin="0,0,0,12" />
                    <ProgressBar Value="100" Maximum="100" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,8,0,0">
                        <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SPEED" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                                <TextBlock Text="42.8 MB/s" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="TRANSFERS" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                                <TextBlock Text="4 ACTIVE / 12 TOTAL" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
