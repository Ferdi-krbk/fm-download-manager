<Window x:Class="McDm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McDm.App"
        Title="FM DOWNLOAD MANAGER" Width="1140" Height="680" MinWidth="900" MinHeight="520"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}"
        Background="{DynamicResource Bg0Brush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BytesConverter x:Key="Bytes" />
        <local:SpeedConverter x:Key="Speed" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static local:MainWindow.PasteCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.PasteCommand}" Executed="PasteUrl_Click" />
    </Window.CommandBindings>

    <!-- Outer 1px Line Border for Borderless WindowChrome -->
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />  <!-- Custom Title Bar -->
                <RowDefinition Height="48" />  <!-- Command Bar -->
                <RowDefinition Height="*" />   <!-- Body: Sidebar + Main Area -->
                <RowDefinition Height="28" />  <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar (36px high, black) -->
            <Border Grid.Row="0" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Title Bar Window Controls Right -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource CaptionBtn}" Content="&#xE921;" Click="Minimize_Click" />
                        <Button Style="{DynamicResource CaptionBtn}" Content="&#xE922;" Click="Maximize_Click" />
                        <Button Style="{DynamicResource CloseCaptionBtn}" Content="&#xE8BB;" Click="Close_Click" />
                    </StackPanel>

                    <!-- Left: Small App Icon + Title in Uppercase -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Image Source="Resources/app.ico" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="FM DOWNLOAD MANAGER" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Command Bar (48px, Bg1, 1px bottom Line) -->
            <Border Grid.Row="1" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <!-- Actions Left -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnAddFromClipboard" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="PasteUrl_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ADD URL" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAddUrls" Style="{DynamicResource SecondaryButton}" Margin="0,0,12,0" Click="AddUrls_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{DynamicResource GlyphFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ADD MULTIPLE" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="0,8,12,8" />

                        <Button x:Name="BtnPause" Style="{DynamicResource IconButton}" Content="&#xE769;" Margin="0,0,4,0" Click="Pause_Click" ToolTip="Pause selected download" />
                        <Button x:Name="BtnResume" Style="{DynamicResource IconButton}" Content="&#xE768;" Margin="0,0,4,0" Click="Resume_Click" ToolTip="Resume selected download" />
                        <Button x:Name="BtnCancel" Style="{DynamicResource IconButton}" Content="&#xE71A;" Margin="0,0,4,0" Click="Cancel_Click" ToolTip="Cancel selected download" />
                        <Button x:Name="BtnRemove" Style="{DynamicResource IconButton}" Content="&#xE74D;" Margin="0,0,12,0" Click="Remove_Click" ToolTip="Remove from list" Foreground="{DynamicResource DangerBrush}" />

                        <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="0,8,12,8" />

                        <Button x:Name="BtnOpenFolder" Style="{DynamicResource GhostButton}" Margin="0,0,4,0" Click="OpenFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED25;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="FOLDER" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Controls: Search Box, Extension Setup, Settings -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Grid Width="240" Margin="0,0,8,0">
                            <TextBox x:Name="TxtSearch" Height="32" Padding="28,0,8,0"
                                     local:WatermarkService.Watermark="SEARCH DOWNLOADS..."
                                     TextChanged="Search_TextChanged" />
                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource GlyphFont}" FontSize="11"
                                       Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="TxtSearchWatermark" Visibility="Collapsed" />
                        </Grid>

                        <Button x:Name="BtnBrowserSetup" Style="{DynamicResource GhostButton}" Margin="0,0,4,0" Click="BrowserSetup_Click" ToolTip="Browser Extension Setup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="EXTENSION" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnSettings" Style="{DynamicResource IconButton}" Content="&#xE713;" Margin="0,0,4,0" Click="Settings_Click" ToolTip="Settings" />
                        <Button x:Name="BtnUpdateYtDlp" Style="{DynamicResource IconButton}" Content="&#xE714;" Click="UpdateYtDlp_Click" ToolTip="Update yt-dlp binary" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. Body: Sidebar (220px, Bg1, 1px right Line) | Content Area (Bg0) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="180" MaxWidth="320" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar (Bg1) -->
                <Border Grid.Column="0" Background="{DynamicResource Bg1Brush}">
                    <DockPanel LastChildFill="True">
                        <!-- Global Speed & Active Block at Sidebar Bottom -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,14" Background="{DynamicResource Bg0Brush}">
                            <StackPanel>
                                <TextBlock Text="TOTAL SPEED" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                                <TextBlock x:Name="TotalSpeedText" Text="0 B/s" FontFamily="{DynamicResource MonoFont}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,2" />
                                <TextBlock x:Name="ActiveCountText" Text="0 ACTIVE" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" Margin="16,16,16,10" />

                        <!-- Category List -->
                        <ListBox x:Name="LstCategories" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="Categories_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Height" Value="36" />
                                    <Setter Property="Padding" Value="14,0" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3Brush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg4Brush}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBoxItem x:Name="CatAll" IsSelected="True" Tag="all">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="ALL DOWNLOADS" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatImages" Tag="images">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB9F;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="IMAGES" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatMusic" Tag="music">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC4F;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MUSIC" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatVideo" Tag="video">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="VIDEOS" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatApps" Tag="apps">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71D;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="APPLICATIONS" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatDocuments" Tag="documents">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="DOCUMENTS" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatArchives" Tag="archives">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF012;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="ARCHIVES" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatOther" Tag="other">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" FontFamily="{DynamicResource GlyphFont}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="OTHER" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Divider 1px Line -->
                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />

                <!-- Main Downloads Area (Bg0) -->
                <Grid Grid.Column="2" Background="{DynamicResource Bg0Brush}">
                    <!-- Downloads DataGrid -->
                    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                              CanUserAddRows="False" MouseDoubleClick="Grid_DoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CtxOpen" Header="OPEN" Click="Open_Click" />
                                <MenuItem x:Name="CtxOpenFolder" Header="OPEN FOLDER" Click="OpenFolder_Click" />
                                <Separator />
                                <MenuItem x:Name="CtxPause" Header="PAUSE" Click="Pause_Click" />
                                <MenuItem x:Name="CtxResume" Header="RESUME" Click="Resume_Click" />
                                <MenuItem x:Name="CtxCancel" Header="CANCEL" Click="Cancel_Click" />
                                <Separator />
                                <MenuItem x:Name="CtxRemove" Header="REMOVE FROM LIST" Click="Remove_Click" />
                                <MenuItem x:Name="CtxRemoveAndDelete" Header="REMOVE &amp; DELETE FILE" Click="RemoveAndDelete_Click" Foreground="{DynamicResource DangerBrush}" />
                                <Separator />
                                <MenuItem x:Name="CtxCopyUrl" Header="COPY URL" Click="CopyUrl_Click" />
                                <MenuItem x:Name="CtxDetails" Header="DETAILS / PROPERTIES" Click="Details_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColHeaderName" Header="NAME" Binding="{Binding FileName}" Width="2*" />
                            <DataGridTextColumn x:Name="ColHeaderSize" Header="SIZE" Binding="{Binding TotalBytes, Converter={StaticResource Bytes}}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn x:Name="ColHeaderProgress" Header="PROGRESS" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="6" />
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" HorizontalAlignment="Right"
                                                       Margin="0,-16,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="ColHeaderSpeed" Header="SPEED" Binding="{Binding Speed, Converter={StaticResource Speed}}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="ColHeaderConn" Header="CONN." Binding="{Binding ActiveConnections}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn x:Name="ColHeaderStatus" Header="STATUS" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Status}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColHeaderError" Header="DETAILS / ERROR" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuteBrush}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Stage}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stage}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Error}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Stage}" Value="">
                                                            <Setter Property="Text" Value="{Binding Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State Overlay (Visible when Items is empty) -->
                    <Border x:Name="EmptyStateOverlay" Background="{DynamicResource Bg0Brush}" Visibility="Collapsed" SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="{DynamicResource GlyphFont}" FontSize="48" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <TextBlock Text="NO DOWNLOADS" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="PASTE A LINK WITH CTRL+V OR USE THE BROWSER EXTENSION" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />
                            <Button Style="{DynamicResource PrimaryButton}" Content="ADD URL" HorizontalAlignment="Center" Width="140" Click="PasteUrl_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. Status Bar (28px high, Bg1, 1px top Line) -->
            <Border Grid.Row="3" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <!-- Left: Status Summary -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock x:Name="StatusCountsText" Text="0 ACTIVE / 0 QUEUED / 0 DONE" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                        <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="12,4" />
                        <TextBlock x:Name="StatusText" Text="Ready" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Bridge Status Dot + Free Disk Space -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="BRIDGE CONNECTED" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock x:Name="DiskSpaceText" Text="DISK: READY" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
