<Window x:Class="McDm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McDm.App"
        Title="FM Download Manager" Width="1140" Height="660" MinWidth="850" MinHeight="480"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Background="#090D16">
    <Window.Resources>
        <local:BytesConverter x:Key="Bytes" />
        <local:SpeedConverter x:Key="Speed" />

        <!-- Cyber Dark Neon Palette -->
        <SolidColorBrush x:Key="BgCanvas" Color="#090D16" />
        <SolidColorBrush x:Key="BgSurface" Color="#131B2E" />
        <SolidColorBrush x:Key="BgSidebar" Color="#0D1322" />
        <SolidColorBrush x:Key="BorderDark" Color="#1E293B" />
        <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentBlue" Color="#6366F1" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />

        <!-- Neon Action Button Style -->
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background" Value="#17223B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#253556" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#203052" />
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#152037" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Gradient Primary Button -->
        <Style x:Key="CyberPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0" />
                                    <GradientStop Color="#4F46E5" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Sidebar Item Style -->
        <Style x:Key="DarkSidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#152037" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2C4B" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#090D16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="#0D1424" />
            <Setter Property="AlternatingRowBackground" Value="#0A0F1C" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#172238" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0A0F1D" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#1E293B" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#162544" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Neon Glow ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0284C7" Offset="0" />
                                        <GradientStop Color="#38BDF8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static local:MainWindow.PasteCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.PasteCommand}" Executed="PasteUrl_Click" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Glassmorphism Toolbar -->
        <Border Grid.Row="0" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons Left -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnAddFromClipboard" Style="{StaticResource CyberPrimaryBtn}" Margin="0,0,8,0" Click="PasteUrl_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="14" />
                            <TextBlock Text="Paste URL" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAddUrls" Style="{StaticResource DarkBtn}" Margin="0,0,12,0" Click="AddUrls_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ " />
                            <TextBlock Text="Add URLs" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="#1E293B" Margin="0,4,12,4" />

                    <Button x:Name="BtnPause" Style="{StaticResource DarkBtn}" Margin="0,0,6,0" Padding="10,6" Click="Pause_Click" ToolTip="Pause">
                        <TextBlock Text="⏸ Pause" />
                    </Button>
                    <Button x:Name="BtnResume" Style="{StaticResource DarkBtn}" Margin="0,0,6,0" Padding="10,6" Click="Resume_Click" ToolTip="Resume">
                        <TextBlock Text="▶ Resume" />
                    </Button>
                    <Button x:Name="BtnCancel" Style="{StaticResource DarkBtn}" Margin="0,0,6,0" Padding="10,6" Click="Cancel_Click" ToolTip="Cancel">
                        <TextBlock Text="⏹ Cancel" />
                    </Button>
                    <Button x:Name="BtnRemove" Style="{StaticResource DarkBtn}" Margin="0,0,12,0" Padding="10,6" Click="Remove_Click" ToolTip="Remove">
                        <TextBlock Text="🗑 Remove" Foreground="#F87171" />
                    </Button>

                    <Border Width="1" Background="#1E293B" Margin="0,4,12,4" />

                    <Button x:Name="BtnOpenFolder" Style="{StaticResource DarkBtn}" Margin="0,0,6,0" Click="OpenFolder_Click">
                        <TextBlock Text="📁 Folder" />
                    </Button>
                </StackPanel>

                <!-- Tools & Settings Right -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnBrowserSetup" Style="{StaticResource DarkBtn}" Margin="0,0,8,0" Click="BrowserSetup_Click">
                        <TextBlock Text="🧩 Extension Setup" />
                    </Button>
                    <Button x:Name="BtnSettings" Style="{StaticResource DarkBtn}" Margin="0,0,8,0" Click="Settings_Click">
                        <TextBlock Text="⚙ Settings" />
                    </Button>
                    <Button x:Name="BtnUpdateYtDlp" Style="{StaticResource DarkBtn}" Click="UpdateYtDlp_Click">
                        <TextBlock Text="🎬 yt-dlp" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body: Cyber Sidebar + Neon Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="320" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cyber Sidebar -->
            <Border Grid.Column="0" Background="#0A0F1D">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="18,18,18,8" />
                    <ListBox x:Name="LstCategories" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource DarkSidebarItemStyle}"
                             SelectionChanged="Categories_SelectionChanged">
                        <ListBoxItem x:Name="CatAll" IsSelected="True" Tag="all">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="All Downloads" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatImages" Tag="images">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼️ " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Images" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatMusic" Tag="music">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎵 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Music" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatVideo" Tag="video">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Video" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatApps" Tag="apps">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Apps" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatDocuments" Tag="documents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Documents" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatArchives" Tag="archives">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗜️ " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Archives" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatOther" Tag="other">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Other" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Divider -->
            <Border Grid.Column="1" Background="#1E293B" />

            <!-- Content Area -->
            <Grid Grid.Column="2" Background="#090D16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search Input Bar -->
                <Border Grid.Row="0" Padding="18,12" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <Grid>
                        <Border Background="#131C31" BorderBrush="#253556" BorderThickness="1" CornerRadius="8" Height="36">
                            <Grid Margin="12,0">
                                <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" FontSize="13" Foreground="#F8FAFC"
                                         TextChanged="Search_TextChanged" />
                                <TextBlock x:Name="TxtSearchWatermark" Text="🔍 Search downloads by name or URL..."
                                           Foreground="#64748B" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Downloads DataGrid -->
                <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                          CanUserAddRows="False" MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#1E293B">
                            <MenuItem x:Name="CtxOpen" Header="Open" Click="Open_Click" />
                            <MenuItem x:Name="CtxOpenFolder" Header="Open folder" Click="OpenFolder_Click" />
                            <Separator Background="#1E293B" />
                            <MenuItem x:Name="CtxPause" Header="Pause" Click="Pause_Click" />
                            <MenuItem x:Name="CtxResume" Header="Resume" Click="Resume_Click" />
                            <MenuItem x:Name="CtxCancel" Header="Cancel" Click="Cancel_Click" />
                            <Separator Background="#1E293B" />
                            <MenuItem x:Name="CtxRemove" Header="Remove from list" Click="Remove_Click" />
                            <MenuItem x:Name="CtxRemoveAndDelete" Header="Remove and delete file" Click="RemoveAndDelete_Click" />
                            <Separator Background="#1E293B" />
                            <MenuItem x:Name="CtxCopyUrl" Header="Copy URL" Click="CopyUrl_Click" />
                            <MenuItem x:Name="CtxDetails" Header="Details" Click="Details_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColHeaderName" Header="NAME" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn x:Name="ColHeaderSize" Header="SIZE" Binding="{Binding TotalBytes, Converter={StaticResource Bytes}}" Width="100" />
                        <DataGridTemplateColumn x:Name="ColHeaderProgress" Header="PROGRESS" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="6" />
                                        <TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" HorizontalAlignment="Right"
                                                   Margin="0,-16,0,0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColHeaderSpeed" Header="SPEED" Binding="{Binding Speed, Converter={StaticResource Speed}}" Width="100" />
                        <DataGridTextColumn x:Name="ColHeaderConn" Header="CONN." Binding="{Binding ActiveConnections}" Width="65" />
                        <DataGridTemplateColumn x:Name="ColHeaderStatus" Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E293B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                        <Setter Property="Background" Value="#0C4A6E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Background" Value="#064E3B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                        <Setter Property="Background" Value="#78350F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Background" Value="#7F1D1D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Status}" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                            <Setter Property="Foreground" Value="#38BDF8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Foreground" Value="#4ADE80" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                            <Setter Property="Foreground" Value="#FBBF24" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Foreground" Value="#F87171" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColHeaderError" Header="DETAILS / ERROR" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis" Foreground="#64748B">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Stage}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding Error}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Stage}" Value="">
                                                        <Setter Property="Text" Value="{Binding Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Dark Status Bar -->
        <Border Grid.Row="2" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="18,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Background="#162544" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right">
                    <TextBlock x:Name="TotalSpeedText" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
