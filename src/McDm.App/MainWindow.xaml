<Window x:Class="McDm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McDm.App"
        Title="FM Download Manager" Width="1100" Height="640" MinWidth="850" MinHeight="450"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Background="#F8FAFC">
    <Window.Resources>
        <local:BytesConverter x:Key="Bytes" />
        <local:SpeedConverter x:Key="Speed" />

        <!-- Modern Colors -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#1D4ED8" />
        <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
        <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF" />

        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Category Item Style -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                <Setter Property="Foreground" Value="#2563EB" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Rounded ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5" />
                            <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static local:MainWindow.PasteCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.PasteCommand}" Executed="PasteUrl_Click" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Modern Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons Left -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnAddFromClipboard" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="PasteUrl_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " />
                            <TextBlock Text="Paste URL" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAddUrls" Style="{StaticResource ModernBtn}" Margin="0,0,12,0" Click="AddUrls_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ " />
                            <TextBlock Text="Add URLs" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="#E2E8F0" Margin="0,4,12,4" />

                    <Button x:Name="BtnPause" Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Padding="10,6" Click="Pause_Click" ToolTip="Pause">
                        <TextBlock Text="⏸ Pause" />
                    </Button>
                    <Button x:Name="BtnResume" Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Padding="10,6" Click="Resume_Click" ToolTip="Resume">
                        <TextBlock Text="▶ Resume" />
                    </Button>
                    <Button x:Name="BtnCancel" Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Padding="10,6" Click="Cancel_Click" ToolTip="Cancel">
                        <TextBlock Text="⏹ Cancel" />
                    </Button>
                    <Button x:Name="BtnRemove" Style="{StaticResource ModernBtn}" Margin="0,0,12,0" Padding="10,6" Click="Remove_Click" ToolTip="Remove">
                        <TextBlock Text="🗑 Remove" Foreground="#DC2626" />
                    </Button>

                    <Border Width="1" Background="#E2E8F0" Margin="0,4,12,4" />

                    <Button x:Name="BtnOpenFolder" Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Click="OpenFolder_Click">
                        <TextBlock Text="📁 Folder" />
                    </Button>
                </StackPanel>

                <!-- Tools & Settings Right -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnBrowserSetup" Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Click="BrowserSetup_Click">
                        <TextBlock Text="🧩 Browser Setup" />
                    </Button>
                    <Button x:Name="BtnSettings" Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Click="Settings_Click">
                        <TextBlock Text="⚙ Settings" />
                    </Button>
                    <Button x:Name="BtnUpdateYtDlp" Style="{StaticResource ModernBtn}" Click="UpdateYtDlp_Click">
                        <TextBlock Text="🎬 Update yt-dlp" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body: Sidebar + DataGrid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="320" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#FFFFFF">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="18,18,18,8" />
                    <ListBox x:Name="LstCategories" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             SelectionChanged="Categories_SelectionChanged">
                        <ListBoxItem x:Name="CatAll" IsSelected="True" Tag="all">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="All Downloads" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatImages" Tag="images">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼️ " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Images" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatMusic" Tag="music">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎵 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Music" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatVideo" Tag="video">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Video" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatApps" Tag="apps">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Apps" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatDocuments" Tag="documents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Documents" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatArchives" Tag="archives">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗜️ " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Archives" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="CatOther" Tag="other">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 " FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Other" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Divider -->
            <Border Grid.Column="1" Background="#E2E8F0" />

            <!-- Main Content Area -->
            <Grid Grid.Column="2" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search Input Bar -->
                <Border Grid.Row="0" Padding="16,12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="34">
                            <Grid Margin="10,0">
                                <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" FontSize="13" Foreground="#0F172A"
                                         TextChanged="Search_TextChanged" />
                                <TextBlock x:Name="TxtSearchWatermark" Text="🔍 Search downloads by name or URL..."
                                           Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Downloads DataGrid -->
                <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                          CanUserAddRows="False" MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CtxOpen" Header="Open" Click="Open_Click" />
                            <MenuItem x:Name="CtxOpenFolder" Header="Open folder" Click="OpenFolder_Click" />
                            <Separator />
                            <MenuItem x:Name="CtxPause" Header="Pause" Click="Pause_Click" />
                            <MenuItem x:Name="CtxResume" Header="Resume" Click="Resume_Click" />
                            <MenuItem x:Name="CtxCancel" Header="Cancel" Click="Cancel_Click" />
                            <Separator />
                            <MenuItem x:Name="CtxRemove" Header="Remove from list" Click="Remove_Click" />
                            <MenuItem x:Name="CtxRemoveAndDelete" Header="Remove and delete file" Click="RemoveAndDelete_Click" />
                            <Separator />
                            <MenuItem x:Name="CtxCopyUrl" Header="Copy URL" Click="CopyUrl_Click" />
                            <MenuItem x:Name="CtxDetails" Header="Details" Click="Details_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColHeaderName" Header="NAME" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn x:Name="ColHeaderSize" Header="SIZE" Binding="{Binding TotalBytes, Converter={StaticResource Bytes}}" Width="100" />
                        <DataGridTemplateColumn x:Name="ColHeaderProgress" Header="PROGRESS" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="8" />
                                        <TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" HorizontalAlignment="Right"
                                                   Margin="0,-16,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColHeaderSpeed" Header="SPEED" Binding="{Binding Speed, Converter={StaticResource Speed}}" Width="100" />
                        <DataGridTextColumn x:Name="ColHeaderConn" Header="CONN." Binding="{Binding ActiveConnections}" Width="65" />
                        <DataGridTemplateColumn x:Name="ColHeaderStatus" Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                        <Setter Property="Background" Value="#DBEAFE" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Status}" />
                                                    <Setter Property="Foreground" Value="#475569" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Foreground" Value="#15803D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColHeaderError" Header="DETAILS / ERROR" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis" Foreground="#64748B">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Stage}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding Error}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Stage}" Value="">
                                                        <Setter Property="Text" Value="{Binding Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Modern Status Bar -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                    <TextBlock x:Name="TotalSpeedText" Foreground="#2563EB" FontWeight="Bold" FontSize="12" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
