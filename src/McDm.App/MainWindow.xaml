<Window x:Class="McDm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McDm.App"
        Title="MC Download Manager" Width="980" Height="560" MinWidth="720" MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BytesConverter x:Key="Bytes" />
        <local:SpeedConverter x:Key="Speed" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static local:MainWindow.PasteCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.PasteCommand}" Executed="PasteUrl_Click" />
    </Window.CommandBindings>
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Add from clipboard" Click="PasteUrl_Click" />
            <Separator />
            <Button Content="Pause" Click="Pause_Click" />
            <Button Content="Resume" Click="Resume_Click" />
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Remove" Click="Remove_Click" />
            <Separator />
            <Button Content="Open folder" Click="OpenFolder_Click" />
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" />
        </StatusBar>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="Size" Binding="{Binding TotalBytes, Converter={StaticResource Bytes}}" Width="90" />
                <DataGridTemplateColumn Header="Progress" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="16" />
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:P0}}" HorizontalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Speed" Binding="{Binding Speed, Converter={StaticResource Speed}}" Width="90" />
                <DataGridTextColumn Header="Conn." Binding="{Binding ActiveConnections}" Width="50" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
