<TextBlock x:Name="TxtEmptyTitle" FontSize="20" HorizontalAlignment="Center"/>
<TextBlock x:Name="TxtEmptySubtitle" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextDimBrush}" Margin="0,10,0,20"/>
<Button x:Name="BtnEmptyAddUrl" Style="{StaticResource FlowPrimary}" Click="PasteUrl_Click" HorizontalAlignment="Center"/>
</StackPanel>
</Border>
</Grid>
<Border ClipToBounds="True" x:Name="FlowInlineDetails" Grid.Row="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Margin="0,20,0,0">
<Border.Style>
<Style TargetType="Border">
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedItem, ElementName=Grid}" Value="{x:Null}">
<Setter Property="Visibility" Value="Collapsed"/>
</DataTrigger>
</Style.Triggers>
</Style>
</Border.Style>
<Grid DataContext="{Binding SelectedItem, ElementName=Grid}">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<DockPanel Margin="13,9">
<Button x:Name="FlowDetailsButton" DockPanel.Dock="Right" Style="{StaticResource FlowButton}" Click="Details_Click"/>
<StackPanel>
<TextBlock x:Name="FlowSelectedLabel" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
<TextBlock Text="{Binding DisplayName}" FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
<StackPanel x:Name="FlowCompactErrorHost"><TextBlock Text="{Binding Error}" ToolTip="{Binding Error}" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
</StackPanel>
</DockPanel>
<Border x:Name="FlowDetailsBody" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="13,9">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="2*"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<StackPanel Margin="0,0,16,0">
<TextBlock Text="{Binding Status, Converter={StaticResource StatusLabel}}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
<TextBlock Text="{Binding Stage}" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
<TextBlock Text="{Binding Error}" ToolTip="{Binding Error}" Foreground="{DynamicResource TextDimBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
</StackPanel>
<StackPanel Grid.Column="1">
<TextBlock x:Name="FlowSizeLabel" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
<TextBlock Text="{Binding DownloadedBytes, Converter={StaticResource Bytes}}" Margin="0,6,0,0"/>
</StackPanel>
<StackPanel Grid.Column="2">
<TextBlock x:Name="FlowEtaLabel" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
<TextBlock Text="{Binding EtaFormatted}" Margin="0,6,0,0"/>
</StackPanel>
</Grid>
</Border>
</Grid>
</Border>
</Grid>
</Grid>
<Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,0">
<DockPanel VerticalAlignment="Center">
<TextBlock Text="FM Download Manager · Windows" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
<StackPanel Orientation="Horizontal">
<TextBlock x:Name="StatusCountsText" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
<TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource TextDimBrush}" Margin="10,0"/>
<TextBlock x:Name="StatusText" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
</StackPanel>
</DockPanel>
</Border>
<StackPanel Visibility="Collapsed">
<TextBlock x:Name="TxtBtnAddMulti" Text="" />
<TextBlock x:Name="TxtBtnFolder" Text="" />
<TextBlock x:Name="LblTransferStatus" Text="" />
<TextBlock x:Name="LblMultiThreadOptimize" Text="" />
<TextBlock x:Name="LblStorageBridge" Text="" />
<TextBlock x:Name="LblBridgeConnected" Text="" />
<TextBlock x:Name="LblNativeBridgeActive" Text="" />
</StackPanel>
<Border x:Name="DragDropOverlay" Grid.Row="1" Background="{DynamicResource Bg0Brush}" Opacity="0.97" Visibility="Collapsed" IsHitTestVisible="False">
<Border Margin="28" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="14">
<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
<local:BrandMark Width="70" Height="45" Margin="0,0,0,24"/>
<TextBlock x:Name="TxtDragDropTitle" FontSize="22"/>
<TextBlock x:Name="TxtDragDropSubtitle" Foreground="{DynamicResource TextDimBrush}" Margin="0,12,0,0"/>
</StackPanel>
</Border>
</Border>
</Grid>
</Border>
</Window>