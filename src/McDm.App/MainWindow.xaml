<Window x:Class="McDm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McDm.App"
        Title="FM Download Manager" Width="1160" Height="700" MinWidth="940" MinHeight="540"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}"
        Background="{DynamicResource Bg0Brush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BytesConverter x:Key="Bytes" />
        <local:SpeedConverter x:Key="Speed" />
        <local:ProgressToBrushConverter x:Key="ProgressBrush" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static local:MainWindow.PasteCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.PasteCommand}" Executed="PasteUrl_Click" />
    </Window.CommandBindings>

    <!-- Outer 1px Line Border for Borderless WindowChrome -->
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />  <!-- Title Bar -->
                <RowDefinition Height="50" />  <!-- Command Bar -->
                <RowDefinition Height="*" />   <!-- Body: Slim Rail + Main Area -->
                <RowDefinition Height="30" />  <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Window Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Title Bar Controls Right -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource WindowMinButtonStyle}" Click="Minimize_Click" />
                        <Button Style="{DynamicResource WindowMaxButtonStyle}" Click="Maximize_Click" />
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="Close_Click" />
                    </StackPanel>

                    <!-- Left: App Icon + Clean Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentDimBrush}" Margin="0,0,8,0">
                            <Image Source="pack://application:,,,/Resources/logo.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="FM Download Manager" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Bg3Brush}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontFamily="{DynamicResource UiFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Command Bar (Toolbar) -->
            <Border Grid.Row="1" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <!-- Actions Left -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnAddFromClipboard" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="PasteUrl_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoAdd}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBtnAdd" Text="URL Ekle" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAddUrls" Style="{DynamicResource SecondaryButton}" Margin="0,0,12,0" Click="AddUrls_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoAddMulti}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBtnAddMulti" Text="Toplu Ekle" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="0,9,12,9" />

                        <!-- Quick control group -->
                        <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnPause" Style="{DynamicResource IconButton}" Click="Pause_Click" ToolTip="Seçileni Duraklat">
                                    <Path Data="{StaticResource GeoPause}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" />
                                </Button>
                                <Button x:Name="BtnResume" Style="{DynamicResource IconButton}" Click="Resume_Click" ToolTip="Seçileni Devam Ettir">
                                    <Path Data="{StaticResource GeoPlay}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" />
                                </Button>
                                <Button x:Name="BtnCancel" Style="{DynamicResource IconButton}" Click="Cancel_Click" ToolTip="Seçileni İptal Et">
                                    <Path Data="{StaticResource GeoStop}" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" />
                                </Button>
                                <Button x:Name="BtnRemove" Style="{DynamicResource IconButton}" Click="Remove_Click" ToolTip="Listeden Kaldır">
                                    <Path Data="{StaticResource GeoTrash}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource DangerBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="0,9,12,9" />

                        <Button x:Name="BtnOpenFolder" Style="{DynamicResource GhostButton}" Margin="0,0,4,0" Click="OpenFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoFolder}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBtnFolder" Text="Klasörü Aç" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Controls: Search Box, Extension Setup, Settings -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Grid Width="220" Margin="0,0,8,0">
                            <TextBox x:Name="TxtSearch" Height="32" Padding="28,0,8,0"
                                     local:WatermarkService.Watermark="İndirmelerde ara..."
                                     TextChanged="Search_TextChanged" />
                            <Path Data="{StaticResource GeoSearch}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource TextMuteBrush}" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="TxtSearchWatermark" Visibility="Collapsed" />
                        </Grid>

                        <Button x:Name="BtnUpdateAvailable" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="UpdateAvailable_Click" ToolTip="Yeni bir sürüm yayınlandı! Tıklayarak inceleyin.">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z" Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtUpdateVersion" Text="Güncelleme Var!" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnBrowserSetup" Style="{DynamicResource GhostButton}" Margin="0,0,4,0" Click="BrowserSetup_Click" ToolTip="Tarayıcı Eklentisi Kurulumu">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoLink}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentHoverBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtBtnExtension" Text="Eklenti" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- Quick Accent Palette Switcher -->
                        <Grid Margin="0,0,4,0">
                            <Button x:Name="BtnPalette" Style="{DynamicResource IconButton}" Click="Palette_Click" ToolTip="Vurgu Rengi Paleti (Kişiselleştir)">
                                <Path Data="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.22 19.38 10.57 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-5 9c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm3-3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm4 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm3 3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" />
                            </Button>
                            <Popup x:Name="PalettePopup" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnPalette}" Placement="Bottom" AllowsTransparency="True" VerticalOffset="6" HorizontalOffset="-140">
                                <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Width="196">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnThemeDark" Grid.Column="0" Style="{DynamicResource SecondaryButton}" Height="26" Content="🌙 Koyu" FontSize="11" Click="QuickThemeDark_Click" />
                                            <Button x:Name="BtnThemeLight" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="26" Content="☀️ Açık" FontSize="11" Click="QuickThemeLight_Click" />
                                        </Grid>
                                        <TextBlock x:Name="LblPaletteHeader" Text="VURGU RENGİ SEÇ" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" Margin="2,0,0,8" />
                                        <WrapPanel x:Name="PnlQuickSwatches" Orientation="Horizontal" Margin="0,0,0,6" />
                                        <Button x:Name="BtnPaletteOpenSettings" Style="{DynamicResource GhostButton}" Height="24" Content="Tüm Ayarları Aç..." FontSize="10.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0" Click="OpenSettingsFromPalette_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button x:Name="BtnSettings" Style="{DynamicResource IconButton}" Margin="0,0,4,0" Click="Settings_Click" ToolTip="Ayarlar">
                            <Path Data="{StaticResource GeoSettings}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" />
                        </Button>
                        <Button x:Name="BtnUpdateYtDlp" Style="{DynamicResource IconButton}" Click="UpdateYtDlp_Click" ToolTip="yt-dlp Güncelle">
                            <Path Data="{StaticResource GeoRefresh}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. Body: Muscular Left Panel (180px) + Main Content Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Muscular Navigation Panel -->
                <Border Grid.Column="0" Background="{DynamicResource Bg1Brush}">
                    <DockPanel LastChildFill="True">
                        <!-- Navigation Header -->
                        <Border DockPanel.Dock="Top" Margin="14,12,14,6">
                            <TextBlock x:Name="LblCategories" Text="KATEGORİLER" FontFamily="{DynamicResource UiFont}"
                                       FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextMuteBrush}" />
                        </Border>

                        <!-- Category List -->
                        <ListBox x:Name="LstCategories" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="Categories_SelectionChanged"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Height" Value="38" />
                                    <Setter Property="Margin" Value="6,1.5" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid SnapsToDevicePixels="True">
                                                    <!-- Razor-sharp Left Indicator -->
                                                    <Border x:Name="Indicator" Width="3" Height="22" Background="{DynamicResource AccentBrush}"
                                                            HorizontalAlignment="Left" Visibility="Collapsed" />
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="2,0"
                                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3Brush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg4Brush}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBoxItem x:Name="CatAll" IsSelected="True" Tag="all" ToolTip="Tüm İndirmeler">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoCatAll}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatAllText" Text="Tüm İndirmeler" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatImages" Tag="images" ToolTip="Resimler">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoCatImages}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatImagesText" Text="Resimler" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatMusic" Tag="music" ToolTip="Müzik">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoCatMusic}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatMusicText" Text="Müzik" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatVideo" Tag="video" ToolTip="Videolar">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoCatVideo}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatVideoText" Text="Videolar" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatApps" Tag="apps" ToolTip="Programlar">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoCatApps}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatAppsText" Text="Programlar" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatDocuments" Tag="documents" ToolTip="Belgeler">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoCatDocs}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatDocsText" Text="Belgeler" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatArchives" Tag="archives" ToolTip="Arşivler">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoCatArchives}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatArchivesText" Text="Arşivler" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatTorrents" Tag="torrents" ToolTip="Torrent / Magnet">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoLink}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatTorrentsText" Text="Torrent / Magnet" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="CatOther" Tag="other" ToolTip="Diğer">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Path Data="{StaticResource GeoCatOther}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CatOtherText" Text="Diğer" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Divider 1px Line -->
                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />

                <!-- Main Downloads Area (Bg0) -->
                <Grid Grid.Column="2" Background="{DynamicResource Bg0Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Top Hero Telemetry Bar -->
                        <RowDefinition Height="*" />    <!-- Elevated Cards DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- TOP HERO TELEMETRY BAR -->
                    <Grid Grid.Row="0" Margin="14,12,14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Bandwidth & Real-time Speed Telemetry -->
                        <Border Grid.Column="0" Background="{DynamicResource HeroCardGradient}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Title & Total Speed -->
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="LblTotalSpeed" Text="CANLI İNDİRME HIZI" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="TotalSpeedText" DockPanel.Dock="Right" Text="0 B/s" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AccentHoverBrush}" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Live Speed Waveform -->
                                <Border Grid.Row="1" CornerRadius="2" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,1,0,4" Padding="2" ClipToBounds="True">
                                    <local:SpeedGraphControl x:Name="SidebarSpeedGraph" Height="36" LineBrush="{DynamicResource AccentBrush}" FillBrush="{DynamicResource SpeedGraphFillBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Border>

                                <!-- Speed Limiter Quick Controls -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Limit:" FontFamily="{DynamicResource UiFont}" FontSize="10.5" Foreground="{DynamicResource TextMuteBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Slider Grid.Column="1" x:Name="SldSpeedLimit" Minimum="0" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="SldSpeedLimit_ValueChanged" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSpeedLimitVal" Text="Sınırsız" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10.5" Foreground="{DynamicResource FlameBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <Button x:Name="BtnSpeedAuto" Content="Oto" Style="{DynamicResource ChipButton}" Margin="1,0" Click="SpeedPreset_Click" Tag="0" />
                                        <Button Content="2M" Style="{DynamicResource ChipButton}" Margin="1,0" Click="SpeedPreset_Click" Tag="2" />
                                        <Button Content="5M" Style="{DynamicResource ChipButton}" Margin="1,0" Click="SpeedPreset_Click" Tag="5" />
                                        <Button Content="10M" Style="{DynamicResource ChipButton}" Margin="1,0" Click="SpeedPreset_Click" Tag="10" />
                                        <Button Content="20M" Style="{DynamicResource ChipButton}" Margin="1,0" Click="SpeedPreset_Click" Tag="20" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Card 2: Transfer Status & Queue Overview -->
                        <Border Grid.Column="2" Background="{DynamicResource HeroCardGradient}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource FlameBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="LblTransferStatus" Text="TRANSFER DURUMU" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActiveCountText" Text="0 aktif indirme" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <TextBlock x:Name="LblMultiThreadOptimize" Text="Paralel parçalama optimize" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMuteBrush}" />
                                </StackPanel>
                                <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" CornerRadius="2" Padding="6,2" Margin="0,3,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="HTTP / Range" FontFamily="{DynamicResource UiFont}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource FlameBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 3: Storage & Bridge Connection Health -->
                        <Border Grid.Column="4" Background="{DynamicResource HeroCardGradient}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="LblStorageBridge" Text="DEPOLAMA &amp; EKLENTİ" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiskSpaceText" Text="DİSK: HAZIR" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5.5" Height="5.5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock x:Name="LblBridgeConnected" Text="Eklenti Bağlı" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" CornerRadius="2" Padding="6,2" Margin="0,3,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="LblNativeBridgeActive" Text="● Native Bridge Aktif" FontFamily="{DynamicResource UiFont}" FontSize="10" Foreground="{DynamicResource TextMuteBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ELEVATED CARDS DATAGRID -->
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                                  CanUserAddRows="False" MouseDoubleClick="Grid_DoubleClick"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="CtxOpen" Header="Aç" Click="Open_Click" />
                                    <MenuItem x:Name="CtxOpenFolder" Header="Klasörü Aç" Click="OpenFolder_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CtxPause" Header="Duraklat" Click="Pause_Click" />
                                    <MenuItem x:Name="CtxResume" Header="Devam Et" Click="Resume_Click" />
                                    <MenuItem x:Name="CtxCancel" Header="İptal Et" Click="Cancel_Click" />
                                    <Separator />
                                    <MenuItem x:Name="CtxRemove" Header="Listeden Kaldır" Click="Remove_Click" />
                                    <MenuItem x:Name="CtxRemoveAndDelete" Header="Kaldır ve Dosyayı Sil" Click="RemoveAndDelete_Click" Foreground="{DynamicResource DangerBrush}" />
                                    <Separator />
                                    <MenuItem x:Name="CtxCopyUrl" Header="Bağlantıyı Kopyala" Click="CopyUrl_Click" />
                                    <MenuItem x:Name="CtxDetails" Header="Ayrıntılar" Click="Details_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <!-- File Name & Icon Column -->
                                <DataGridTemplateColumn x:Name="ColHeaderName" Header="Dosya Adı" Width="2.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                <Border Width="28" Height="28" CornerRadius="3" Background="{DynamicResource Bg3Brush}" Margin="0,0,10,0">
                                                    <Path Data="{StaticResource GeoCatDocs}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding Stage}" FontSize="10.5" Foreground="{DynamicResource TextMuteBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Size Column -->
                                <DataGridTemplateColumn x:Name="ColHeaderSize" Header="Boyut" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource Bytes}}"
                                                       FontFamily="{DynamicResource UiFont}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                <Setter Property="Foreground" Value="{Binding Progress, Converter={StaticResource ProgressBrush}}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Progress Column -->
                                <DataGridTemplateColumn x:Name="ColHeaderProgress" Header="İlerleme" Width="185">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="6" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11.5" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding Progress, Converter={StaticResource ProgressBrush}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuteBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuteBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ETA / Remaining Time Column -->
                                <DataGridTemplateColumn x:Name="ColHeaderEta" Header="Kalan Süre" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="2" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="11.5" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding EtaFormatted}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                    <Setter Property="Foreground" Value="{Binding Progress, Converter={StaticResource ProgressBrush}}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    <Setter Property="Text" Value="{Binding EtaFormatted}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuteBrush}" />
                                                                    <Setter Property="Text" Value="—" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Speed Column -->
                                <DataGridTemplateColumn x:Name="ColHeaderSpeed" Header="Hız" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="2" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="—" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuteBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                    <Setter Property="Text" Value="{Binding Speed, Converter={StaticResource Speed}}" />
                                                                    <Setter Property="Foreground" Value="{Binding Progress, Converter={StaticResource ProgressBrush}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Connections Column -->
                                <DataGridTemplateColumn x:Name="ColHeaderConn" Header="Bağl." Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="2" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="—" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuteBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                    <Setter Property="Text" Value="{Binding ActiveConnections}" />
                                                                    <Setter Property="Foreground" Value="{Binding Progress, Converter={StaticResource ProgressBrush}}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status Column -->
                                <DataGridTemplateColumn x:Name="ColHeaderStatus" Header="Durum" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="2" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Background" Value="#2210B981" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Background" Value="#22EF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource TextDimBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                        <Setter Property="Fill" Value="{Binding Progress, Converter={StaticResource ProgressBrush}}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Status}" FontFamily="{DynamicResource UiFont}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                        <Setter Property="Foreground" Value="{Binding Progress, Converter={StaticResource ProgressBrush}}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Details / Error Column -->
                                <DataGridTemplateColumn x:Name="ColHeaderError" Header="Ayrıntılar" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="{DynamicResource UiFont}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuteBrush}" />
                                                        <Setter Property="Text" Value="{Binding Stage}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Stage}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="{Binding Error}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Stage}" Value="">
                                                                <Setter Property="Text" Value="{Binding Error}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                                <Setter Property="Foreground" Value="{Binding Progress, Converter={StaticResource ProgressBrush}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Modern Empty State Overlay -->
                        <Border x:Name="EmptyStateOverlay" Background="{DynamicResource Bg0Brush}" Visibility="Collapsed" SnapsToDevicePixels="True">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Bg2Brush}" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <Path Data="{StaticResource GeoAdd}" Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="TxtEmptyTitle" Text="Henüz indirme yok" FontFamily="{DynamicResource UiFont}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtEmptySubtitle" Text="İndirme başlatmak için bir bağlantı yapıştırın veya tarayıcı eklentisini kullanın." FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,22" />
                                <Button x:Name="BtnEmptyAddUrl" Style="{DynamicResource PrimaryButton}" Content="URL Ekle" HorizontalAlignment="Center" Width="140" Height="34" Click="PasteUrl_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 4. Status Bar (30px) -->
            <Border Grid.Row="3" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <!-- Right: Info -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="FM Download Manager · Windows" FontFamily="{DynamicResource UiFont}" FontSize="10.5" Foreground="{DynamicResource TextMuteBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Left: Status Summary -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusCountsText" Text="0 aktif / 0 sırada / 0 tamamlandı" FontFamily="{DynamicResource UiFont}" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource LineBrush}" Margin="14,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Hazır" FontFamily="{DynamicResource UiFont}" FontSize="11.5" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Modern Drag & Drop Glassmorphic Overlay -->
            <Border x:Name="DragDropOverlay" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="999"
                    Background="{DynamicResource Bg0Brush}" Opacity="0.96" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid Margin="24">
                    <Rectangle Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="4 2"
                               RadiusX="12" RadiusY="12" Fill="{DynamicResource AccentDimBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Bg2Brush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource GeoAdd}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtDragDropTitle" Text="İndirmeyi Başlatmak İçin Buraya Bırakın" FontFamily="{DynamicResource UiFont}"
                                   FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock x:Name="TxtDragDropSubtitle" Text="URL bağlantıları, web linkleri veya .torrent dosyaları desteklenir"
                                   FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
