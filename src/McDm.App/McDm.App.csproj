<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for NotifyIcon (tray) -->
    <RootNamespace>McDm.App</RootNamespace>
    <AssemblyName>FMDownloadManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <Version>3.4.2</Version>
    <AssemblyVersion>3.4.2.0</AssemblyVersion>
    <FileVersion>3.4.2.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms and WPF both define Application, Clipboard, MessageBox...: keep WinForms out of the implicit usings -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\McDm.Core\McDm.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\Tools\**\*" Condition="Exists('..\..\Tools')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Tools\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\extension\**\*" Condition="Exists('..\..\extension')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\docs\EKLENTI_KURULUMU.html" Condition="Exists('..\..\docs\EKLENTI_KURULUMU.html')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="EKLENTI_KURULUMU.html" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
