<Window x:Class="McDm.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SETTINGS" Width="640" Height="620" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg0Brush}"
        FontFamily="{DynamicResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Settings Content -->
                <RowDefinition Height="56" />  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="Cancel_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtWinHeader" Text="Ayarlar" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="14,0" />
                </DockPanel>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Download Folder Section -->
                    <TextBlock x:Name="LblDlFolder" Text="DEFAULT DOWNLOAD DIRECTORY" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDlFolder" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
                        <Button x:Name="BtnBrowse" Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="BROWSE" Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>

                    <Separator Margin="0,0,0,18" />

                    <!-- Connections & Concurrent -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LblConnections" Text="CONNECTIONS PER DOWNLOAD" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtConnections" FontFamily="{DynamicResource MonoFont}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="LblMaxConcurrent" Text="MAX CONCURRENT TASKS" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtMaxConcurrent" FontFamily="{DynamicResource MonoFont}" />
                        </StackPanel>
                    </Grid>

                    <!-- Speed & Min Size -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LblSpeedLimit" Text="GLOBAL SPEED LIMIT (KB/S, 0=OFF)" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtSpeedLimit" FontFamily="{DynamicResource MonoFont}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="LblMinSize" Text="MIN INTERCEPT SIZE (MB)" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtMinSize" FontFamily="{DynamicResource MonoFont}" />
                        </StackPanel>
                    </Grid>

                    <!-- Captured Extensions -->
                    <TextBlock x:Name="LblCaptureExts" Text="CAPTURED FILE EXTENSIONS" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtCaptureExts" Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}" FontSize="11" Margin="0,0,0,18" />

                    <Separator Margin="0,0,0,18" />

                    <!-- Video Settings -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LblVideoFormat" Text="PREFERRED VIDEO CONTAINER" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="CmbVideoFormat" SelectedIndex="0">
                                <ComboBoxItem Content="mp4" />
                                <ComboBoxItem Content="mkv" />
                                <ComboBoxItem Content="webm" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="LblVideoQuality" Text="MAX VIDEO RESOLUTION" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="CmbVideoQuality" SelectedIndex="2">
                                <ComboBoxItem Content="2160p (4K)" Tag="2160" />
                                <ComboBoxItem Content="1440p (2K)" Tag="1440" />
                                <ComboBoxItem Content="1080p (Full HD)" Tag="1080" />
                                <ComboBoxItem Content="720p (HD)" Tag="720" />
                                <ComboBoxItem Content="480p (SD)" Tag="480" />
                                <ComboBoxItem Content="Best available" Tag="0" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Language Selection -->
                    <TextBlock x:Name="LblLanguage" Text="INTERFACE LANGUAGE" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="CmbLanguage" Margin="0,0,0,18" SelectedIndex="0">
                        <ComboBoxItem Content="Follow Windows (Otomatik)" Tag="auto" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                    </ComboBox>

                    <Separator Margin="0,0,0,18" />

                    <!-- Toggles -->
                    <CheckBox x:Name="ChkStartWithWindows" Content="START WITH WINDOWS" Margin="0,0,0,12" />
                    <CheckBox x:Name="ChkClipboardWatcher" Content="MONITOR CLIPBOARD FOR DOWNLOAD LINKS" Margin="0,0,0,12" />
                    <CheckBox x:Name="ChkNotifications" Content="SHOW SYSTEM NOTIFICATIONS ON COMPLETION" Margin="0,0,0,12" />
                    <CheckBox x:Name="ChkAutoCategorize" Content="Kategoriye göre alt klasörleme yap (Videos, Music, Torrents vb.)" Margin="0,0,0,18" />

                    <Separator Margin="0,0,0,18" />

                    <!-- Scheduler (Zamanlayıcı) -->
                    <TextBlock x:Name="LblScheduler" Text="ZAMANLAYICI / KUYRUK PLANLAYICI" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkScheduler" Content="Zamanlayıcıyı etkinleştir (Planlanan saat aralığında çalış)" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LblSchedStart" Text="BAŞLANGIÇ SAATİ (SS:dd)" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtSchedStart" FontFamily="{DynamicResource MonoFont}" Text="02:00" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="LblSchedStop" Text="BİTİŞ SAATİ (SS:dd)" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtSchedStop" FontFamily="{DynamicResource MonoFont}" Text="07:00" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ChkSchedAutoResume" Content="Başlangıç saatinde duraklatılan indirmeleri otomatik başlat" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkSchedAutoPause" Content="Bitiş saatinde çalışan indirmeleri otomatik duraklat" Margin="0,0,0,14" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCancel" Style="{DynamicResource SecondaryButton}" Content="CANCEL" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="BtnSave" Style="{DynamicResource PrimaryButton}" Content="SAVE" Width="100" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
