<Window x:Class="McDm.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="600" Height="620" MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    <Window.Resources>
        <Style x:Key="SetBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetPrimaryBtn" TargetType="Button" BasedOn="{StaticResource SetBtn}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0369A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Download Folder -->
                <TextBlock x:Name="LblDlFolder" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtDlFolder" Grid.Column="0" Height="34" />
                    <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource SetBtn}" Margin="8,0,0,0" Height="34" Click="Browse_Click" />
                </Grid>

                <!-- Concurrency and connections -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="LblConnections" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtConnections" Height="34" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock x:Name="LblMaxConcurrent" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtMaxConcurrent" Height="34" />
                    </StackPanel>
                </Grid>

                <!-- Speed limit & Min capture size -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="LblSpeedLimit" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtSpeedLimit" Height="34" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock x:Name="LblMinSize" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtMinSize" Height="34" />
                    </StackPanel>
                </Grid>

                <!-- Captured Extensions -->
                <TextBlock x:Name="LblCaptureExts" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                <TextBox x:Name="TxtCaptureExts" Height="54" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,18" />

                <!-- Video settings -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="LblVideoFormat" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbVideoFormat" Height="34" SelectedIndex="0">
                            <ComboBoxItem Content="mp4" />
                            <ComboBoxItem Content="mkv" />
                            <ComboBoxItem Content="webm" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock x:Name="LblVideoQuality" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbVideoQuality" Height="34" SelectedIndex="2">
                            <ComboBoxItem Content="2160p (4K)" Tag="2160" />
                            <ComboBoxItem Content="1440p (2K)" Tag="1440" />
                            <ComboBoxItem Content="1080p (Full HD)" Tag="1080" />
                            <ComboBoxItem Content="720p (HD)" Tag="720" />
                            <ComboBoxItem Content="480p (SD)" Tag="480" />
                            <ComboBoxItem Content="Best available" Tag="0" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Language -->
                <TextBlock x:Name="LblLanguage" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6" />
                <ComboBox x:Name="CmbLanguage" Height="34" Margin="0,0,0,18" SelectedIndex="0">
                    <ComboBoxItem Content="Follow Windows (Otomatik)" Tag="auto" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Türkçe" Tag="tr" />
                </ComboBox>

                <!-- Checkboxes -->
                <CheckBox x:Name="ChkStartWithWindows" Margin="0,0,0,10" />
                <CheckBox x:Name="ChkClipboardWatcher" Margin="0,0,0,10" />
                <CheckBox x:Name="ChkNotifications" Margin="0,0,0,18" />
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnSave" Style="{StaticResource SetPrimaryBtn}" IsDefault="True" Width="110" Height="34" Margin="0,0,8,0" Click="Save_Click" />
            <Button x:Name="BtnCancel" Style="{StaticResource SetBtn}" IsCancel="True" Width="90" Height="34" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
