<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Color Palette: Hard Black / Orange -->
    <Color x:Key="ColorBg0">#000000</Color>
    <Color x:Key="ColorBg1">#0A0A0A</Color>
    <Color x:Key="ColorBg2">#121212</Color>
    <Color x:Key="ColorBg3">#1A1A1A</Color>
    <Color x:Key="ColorBg4">#242424</Color>
    <Color x:Key="ColorLine">#2A2A2A</Color>
    <Color x:Key="ColorLineStrong">#3A3A3A</Color>
    <Color x:Key="ColorText">#F2F2F2</Color>
    <Color x:Key="ColorTextDim">#A0A0A0</Color>
    <Color x:Key="ColorTextMute">#6B6B6B</Color>
    <Color x:Key="ColorAccent">#FF6A00</Color>
    <Color x:Key="ColorAccentHover">#FF8533</Color>
    <Color x:Key="ColorAccentPress">#E05A00</Color>
    <Color x:Key="ColorAccentDim">#3A1A00</Color>
    <Color x:Key="ColorOnAccent">#000000</Color>
    <Color x:Key="ColorDanger">#FF3B3B</Color>
    <Color x:Key="ColorSuccess">#3DDC84</Color>
    <Color x:Key="ColorAltRow">#0E0E0E</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource ColorBg0}" />
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource ColorBg1}" />
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource ColorBg2}" />
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource ColorBg3}" />
    <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource ColorBg4}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource ColorLine}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource ColorLineStrong}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource ColorTextDim}" />
    <SolidColorBrush x:Key="TextMuteBrush" Color="{StaticResource ColorTextMute}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="{StaticResource ColorAccentPress}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource ColorAccentDim}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource ColorOnAccent}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="AltRowBrush" Color="{StaticResource ColorAltRow}" />

    <!-- CornerRadius = 0 everywhere -->
    <CornerRadius x:Key="SharpCorner">0</CornerRadius>
    <Thickness x:Key="BorderThickness1">1</Thickness>
    <Thickness x:Key="BorderThickness2">2</Thickness>

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, monospace</FontFamily>
    <FontFamily x:Key="GlyphFont">Segoe MDL2 Assets, Segoe Fluent Icons, sans-serif</FontFamily>

    <!-- SystemColors overrides so fallback WPF components stay hard black / orange -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource ColorBg0}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource ColorBg1}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource ColorAccentDim}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource ColorBg4}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource ColorTextMute}" />
</ResourceDictionary>
