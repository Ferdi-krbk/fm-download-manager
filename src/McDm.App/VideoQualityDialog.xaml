<Window x:Class="McDm.App.VideoQualityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VİDEO KALİTESİ &amp; FORMAT SEÇİMİ" Width="520" Height="420" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg0Brush}"
        FontFamily="{DynamicResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />  <!-- Title Bar -->
                <RowDefinition Height="*" />   <!-- Content Area -->
                <RowDefinition Height="56" />  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{DynamicResource WindowCloseButtonStyle}" Click="Cancel_Click" />
                    </StackPanel>
                    <TextBlock Text="Video Kalitesi &amp; Formatı Seçin" FontFamily="{DynamicResource UiFont}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="14,0" />
                </DockPanel>
            </Border>

            <!-- Main Content -->
            <StackPanel Grid.Row="1" Margin="20,16,20,10">
                <TextBlock x:Name="TxtVideoTitle" Text="İndirilecek Video" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtVideoUrl" Text="https://..." FontSize="11" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,14" TextTrimming="CharacterEllipsis" />

                <TextBlock Text="KALİTE VE FORMAT SEÇENEĞİ:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />

                <!-- Radio List of Formats -->
                <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                    <StackPanel>
                        <RadioButton x:Name="OptBest" IsChecked="True" Margin="0,4" GroupName="QualityGroup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="En Yüksek Kalite (Otomatik 4K/1080p)" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="En iyi video ve ses akışlarını birleştirir (Önerilen)" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4" />

                        <RadioButton x:Name="Opt1080p" Margin="0,4" GroupName="QualityGroup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="1080p Full HD (MP4)" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="Standart yüksek çözünürlük" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4" />

                        <RadioButton x:Name="Opt720p" Margin="0,4" GroupName="QualityGroup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="720p HD (Hızlı İndirme)" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="Daha küçük dosya boyutu, hızlı aktarım" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4" />

                        <RadioButton x:Name="OptAudioOnly" Margin="0,4" GroupName="QualityGroup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎵" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Yalnızca Ses Çıkar (MP3 / 320 kbps)" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="Görüntüyü atar, sadece müziği / sesi kaydeder" FontSize="10.5" Foreground="{DynamicResource TextDimBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource SecondaryButton}" Content="Vazgeç" Width="85" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Style="{DynamicResource PrimaryButton}" Content="İndirmeyi Başlat" MinWidth="130" Padding="14,0" Click="Start_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
